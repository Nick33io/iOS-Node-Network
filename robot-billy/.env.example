# Copy to robot-billy/.env and export the values in your shell.
# Never commit a real key.

JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana CLI keypair (JSON byte array). Prefer this over a raw secret.
WALLET_KEYPAIR_PATH=
# BS58_PRIVATE_KEY=

# Paper bankroll split across six bots. Ignored once var/state.json exists.
ROBOT_BILLY_BANKROLL_USDC=6000
ROBOT_BILLY_MAX_TRADE_USDC=50
ROBOT_BILLY_MAX_DAILY_LOSS_USDC=100
ROBOT_BILLY_MAX_PRICE_IMPACT=0.01

# Extra mints the field may trade, comma-separated. SOL and USDC are always the default pair.
# ROBOT_BILLY_ALLOW_MINTS=

# Live swaps stay off until both of these are set. The confirmation string is exact.
ROBOT_BILLY_LIVE=0
# ROBOT_BILLY_LIVE_CONFIRM=I_UNDERSTAND_THIS_CAN_LOSE_FUNDS
